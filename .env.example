# Koneksi database Postgres Neon (wajib)
# Gunakan connection string dari dashboard Neon.
# Contoh: postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/kembabershop?sslmode=require
DATABASE_URL=

# Rahasia untuk menandatangani cookie sesi (wajib, minimal 32 karakter acak)
SESSION_SECRET=

# Kredensial owner / admin barbershop
OWNER_USERNAME=owner
OWNER_PASSWORD=ganti-password-ini

# URL publik aplikasi (dipakai untuk QR check-in jika diisi)
# NEXT_PUBLIC_APP_URL=https://kembabershop.example.com

# Kunci untuk token QR check-in statis. Ganti jika QR bocor, lalu cetak ulang QR.
CHECKIN_QR_SECRET=ganti-dengan-string-acak-panjang

# Opsional: aktifkan kembali pembatasan check-in.
# CHECKIN_COOLDOWN_HOURS=72
# CHECKIN_REQUIRE_SHOP_OPEN=true